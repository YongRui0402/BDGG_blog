{{- /*
  自訂的 RSS，不用 Hugo 內建的那一份，原因有三個：
    1. 內建的 <description> 固定是 "Recent content on <站名>"，這裡用 hugo.toml 的站台說明
    2. 內建的會把「關於」這種不屬於任何分區的單頁也放進去，這裡只收分區底下的文章
    3. 內建的只給摘要，這裡多給全文（content:encoded）—— 技術文章在閱讀器裡直接讀完比較實用

  只給最新的 30 篇。全文裡的站內連結與圖片是從網域根算起的路徑（/BDGG_blog/…），
  閱讀器不一定會替它補上網域，所以輸出前換成完整網址。
*/ -}}
{{- $pages := first 30 (where site.RegularPages "Section" "ne" "").ByDate.Reverse -}}
{{- $root := "" | relURL -}}
{{- $absRoot := "" | absURL -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/" xmlns:dc="http://purl.org/dc/elements/1.1/">
  <channel>
    <title>{{ site.Title }}</title>
    <link>{{ site.Home.Permalink }}</link>
    <description>{{ site.Params.description | htmlEscape }}</description>
    <language>{{ site.Language.Locale }}</language>
    <copyright>{{ site.Params.author }} · 文章以 CC BY 4.0 授權</copyright>
    {{- with index $pages 0 }}
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- end }}
    {{- with .OutputFormats.Get "rss" }}
    <atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml" />
    {{- end }}
    {{- range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid isPermaLink="true">{{ .Permalink }}</guid>
      <dc:creator>{{ site.Params.author }}</dc:creator>
      {{- with partial "sect-name.html" . }}
      <category>{{ . }}</category>
      {{- end }}
      <description>{{ partial "description.html" . | htmlEscape }}</description>
      {{- $content := replace .Content (printf "=\"%s" $root) (printf "=\"%s" $absRoot) }}
      <content:encoded>{{ $content | transform.XMLEscape | safeHTML }}</content:encoded>
    </item>
    {{- end }}
  </channel>
</rss>
